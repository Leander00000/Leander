NEXT_PUBLIC_SUPABASE_URL=https://uztowxvvzuonlbasifnq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Private server-only Google owner allow list
