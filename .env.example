# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://uztowxvvzuonlbasifnq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Private server-only owner profile and device access
# Use the EXISTING owner UUID from Supabase Authentication > Users.
OWNER_USER_ID=
# Supabase secret key (sb_secret_...) or legacy service_role; NEVER NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_ACCESS_KEY=
OWNER_EMAIL=your_supabase_user@example.com

# Stable app origin (no trailing slash)
APP_ORIGIN=http://localhost:3000

# Private server-side integrations
TODOIST_API_TOKEN=replace_me

# Calendar OAuth client from its own Google Cloud project
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback

# Exactly 32 random bytes encoded as base64 (`openssl rand -base64 32`)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Set to true only when you deliberately want sample data
NEXT_PUBLIC_DEMO_MODE=false
